{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assumption",
  "type": "object",
  "properties": {
    "assumption_id": { "type": "string" },
    "statement": { "type": "string" },
    "value": { "type": "string" },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 1, "maximum": 10 },
    "impact_if_wrong": { "type": "string", "enum": ["High", "Medium", "Low"] },
    "validation_method": { "type": "string" }
  },
  "required": ["assumption_id", "statement", "confidence", "impact_if_wrong"]
}
