{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "properties": {
    "evidence_id": { "type": "string" },
    "statement": { "type": "string" },
    "type": { "type": "string", "enum": ["FACT", "OBSERVED", "INFERENCE", "HYPOTHESIS", "ASSUMPTION", "UNKNOWN"] },
    "source": { "type": "string" }
  },
  "required": ["evidence_id", "statement", "type"]
}
